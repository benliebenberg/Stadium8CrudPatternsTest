# Copy this file to .env.local and fill in the API key.
#
# HOW THIS APP TALKS TO ITS BACKEND
# The browser only ever calls this app's own same-origin /api/* route handlers. Those
# handlers run on the server, and they are the only code that reaches the Linx
# CrudPatterns backend — because the API key is a single shared secret that must never
# reach the browser, and because the Linx host emits no CORS headers, so a direct
# browser call would be blocked anyway.

# The Linx backend's base address, used by the SERVER TIER ONLY.
# Note the /crud-patterns prefix: it is part of the Linx runtime's Base URI. Without it
# every request 404s. (The OpenAPI document embedded in the Linx solution declares
# http://localhost:10002 — that value is wrong; see generated-docs/project.md.)
NEXT_PUBLIC_API_BASE_URL=http://localhost:10002/crud-patterns

# The shared API key, sent as the X-API-Key header on every backend call.
# SERVER-ONLY — deliberately NOT prefixed NEXT_PUBLIC_, because anything so prefixed is
# baked into the browser bundle and readable by anyone. Set the value in .env.local only
# (it is git-ignored); never commit it.
API_KEY=

# The fixed name every write is recorded against, sent as the LastChangedUser header.
# SERVER-ONLY, and deployment configuration rather than identity: this app has no login,
# so every record shows this same value. There is no prompt and no in-app way to change
# it. Defaults to "Animal Manager" when unset.
LAST_CHANGED_USER=Animal Manager

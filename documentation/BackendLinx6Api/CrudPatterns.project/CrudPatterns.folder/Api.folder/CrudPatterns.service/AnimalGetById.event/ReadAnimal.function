    {
      "Id": "SQL",
      "Type": "Compiled:String?",
      "ValueUsage": "RuntimeRead",
      "Value": "SELECT\r\n\tAnimal.Id,\r\n\tAnimal.[Name],\r\n\tAnimal.Species,\r\n\tAnimal.Age,\r\n\tAnimal.HabitatId,\r\n\tHabitat.[Name] AS HabitatName,\r\n\tAnimal.Diet,\r\n\tAnimal.LastChangedUser,\r\n\tFORMAT(Animal.LastChangedDate AT TIME ZONE 'UTC' AT TIME ZONE 'South Africa Standard Time', 'yyyy-MM-dd HH:mm:ss') AS LastChangedDate\r\n\r\nFROM\r\n\tAnimal\r\nINNER JOIN\r\n\tHabitat ON Habitat.Id = Animal.HabitatId\r\nWHERE\r\n\tAnimal.Id = @{$.Parameters.Id}"
    },

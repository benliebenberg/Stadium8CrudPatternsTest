      "Type": "Compiled:String?",
      "ValueUsage": "RuntimeRead",
      "Value": "INSERT INTO Animal \r\n(\r\n\t[Name], \r\n\tSpecies, \r\n\tAge, \r\n\tHabitatId, \r\n\tDiet, \r\n\tLastChangedUser\r\n)\r\nVALUES\r\n(\r\n\t@{$.Parameters.body.Name},\r\n\t@{$.Parameters.body.Species},\r\n\t@{$.Parameters.body.Age},\r\n\t@{$.Parameters.body.HabitatId},\r\n\t@{$.Parameters.body.Diet},\r\n\t@{$.Parameters.LastChangedUser}\r\n)\r\n\r\nSELECT Id = CAST(SCOPE_IDENTITY() AS INT)"
